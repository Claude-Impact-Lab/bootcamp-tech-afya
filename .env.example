# Banco de dados - SQLite local
# Dados armazenados em: usermanager.db (arquivo local)
DATABASE_URL=sqlite:///usermanager.db

# Altere antes de publicar o sistema.
ADMIN_USERNAME=Ademilson
ADMIN_PASSWORD=12345678
# Gere um valor longo e aleatorio para ambientes persistentes.
SESSION_SECRET=troque-esta-chave-por-um-valor-longo-e-aleatorio

# Validacao local na pagina publica do CFM. O Chrome abre para CAPTCHA manual.
CFM_PLAYWRIGHT_TIMEOUT_SECONDS=120
CFM_BROWSER_CHANNEL=chrome
# Preencha somente se o Chrome nao for encontrado automaticamente.
CFM_BROWSER_PATH=
CFM_CACHE_TTL_SECONDS=3600
CFM_MIN_REQUEST_INTERVAL_SECONDS=3
