# Copie este arquivo para .env e troque a senha antes de compartilhar o ambiente.
POSTGRES_DB=usermanager
POSTGRES_USER=usermanager
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://usermanager:troque-esta-senha@localhost:5432/usermanager
# Credenciais de demonstração do painel administrativo. Não use estes valores em produção.
ADMIN_NAME=santanna
ADMIN_PASSWORD=12345
SESSION_SECRET=troque-esta-chave-de-sessao
# Validação local pelo portal público do CFM. O CAPTCHA, quando existir, é manual.
CFM_VALIDATION_METHOD=browser
CFM_BROWSER_TIMEOUT_SECONDS=120
CFM_BROWSER_HEADLESS=false
CFM_BROWSER_CHANNEL=chrome
# Alternativa SOAP preservada para desenvolvimento futuro.
CFM_ACCESS_KEY=
CFM_WS_URL=https://ws.cfm.org.br:8080/WebServiceConsultaMedicos/ServicoConsultaMedicos
CFM_TIMEOUT_SECONDS=10
